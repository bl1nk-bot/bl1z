root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# bl1z generates markdown tables (e.g. `bl1z plugins list --markdown`);
# the renderer reads this cap and truncates wide cells with "…" to fit.
max_line_length = 120
